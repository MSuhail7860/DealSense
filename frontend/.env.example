# DealSense Frontend Environment Variables

# Backend API Base URL (FastAPI)
# Leave empty or set to /api/v1 to use Vite's built-in dev proxy, or point to http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ML Microservice Base URL (FastAPI /predict)
# Leave empty or set to /ml to use Vite's proxy, or point directly to http://localhost:8001
VITE_ML_API_BASE_URL=http://localhost:8001

# WebSocket URL for real-time deal score updates
VITE_WS_URL=ws://localhost:8000/ws/scores
